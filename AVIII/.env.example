# Copie para .env e ajuste. O .env não vai para o git.
# Portas publicadas pelo docker-compose.yml. Mude só se já houver PostgreSQL/Redis local nelas
# (ex.: 55432/56379) e ajuste a porta nas URLs abaixo para o mesmo valor.
#POSTGRES_PORTA=5432
#REDIS_PORTA=6379
DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode?schema=public"
# Banco usado apenas pelos testes automatizados (é apagado e recriado a cada execução).
DATABASE_URL_TESTE="postgresql://greencode:greencode@localhost:5432/greencode_teste?schema=public"

PORT=3000
HOST=0.0.0.0
# Segredo de assinatura dos tokens JWT: no mínimo 32 caracteres aleatórios.
JWT_SEGREDO="troque-este-segredo-por-um-valor-aleatorio-longo"
# Minutos de inatividade até o token expirar.
SESSAO_MINUTOS=30
# Nível de log do Fastify: fatal, error, warn, info, debug, trace ou silent.
LOG_NIVEL=info

# ---------------------------------------------------------------- AV3: fila, agendamentos e API pública
# Redis da fila BullMQ e do limite de requisições compartilhado entre instâncias.
# Sem REDIS_URL a fila fica em memória (bom para desenvolvimento; não use com várias instâncias).
REDIS_URL="redis://localhost:6379/0"
# Redis dos testes da fila BullMQ (outro banco lógico). Sem ele, esses testes são ignorados.
REDIS_URL_TESTE="redis://localhost:6379/1"
# true: o servidor também processa a fila e os agendamentos. Com várias instâncias da API,
# use false e rode "npm run worker" separadamente.
WORKER_EMBUTIDO=true
# Análises recorrentes (cron: minuto hora dia mês dia-da-semana). Vazio desativa.
ANALISES_CRON="0 2 * * *"
FUSO_AGENDAMENTOS=America/Sao_Paulo
# Política de retry dos relatórios: tentativas e espera inicial (dobra a cada falha).
FILA_TENTATIVAS=3
FILA_ATRASO_MS=5000
# Relatórios processados ao mesmo tempo por worker.
FILA_CONCORRENCIA=2
# Horas em que o arquivo de um relatório fica disponível para download.
RELATORIO_RETENCAO_HORAS=72
RELATORIOS_SIMULTANEOS_POR_USUARIO=5
# Proteção por IP (o limite de cada parceiro vem do plano da chave de API).
LIMITE_LOGIN_POR_MINUTO=20
LIMITE_PUBLICO_POR_IP_POR_MINUTO=600
# Atrás de um proxy reverso (Nginx/Caddy): true para usar o IP real do X-Forwarded-For.
TRUST_PROXY=false
