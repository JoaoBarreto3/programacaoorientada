@startuml greencode
' Diagrama de classes do greencode. Reproduz o UML do enunciado (mesmos membros e relacionamentos);
' elementos marcados com <<acréscimo>> atendem a requisitos do texto que o diagrama original não detalha.
' Gere a imagem com: java -jar plantuml.jar docs/uml/greencode.puml  (ou pela extensão PlantUML do VS Code)
skinparam classAttributeIconSize 0
hide empty members

class CLIInterface {
  autenticacao: ServicoAutenticacao
  organizacao: ServicoOrganizacao
  lote: ServicoLote
  equipamento: ServicoEquipamento
  relatorio: ServicoRelatorio
  sessaoAtual: Sessao | null
  iniciarLoop(): void
  processarComando(entrada: string): void
  exibirMenuPorPapel(papel: PapelUsuario): void
}

class JournalTransacao {
  id: string
  timestamp: Date
  operacao: string
  entidade: string
  dadosAntes: any
  dadosDepois: any
  usuarioResponsavel: string
  registrar(): void
  reverter(): boolean
}

interface Autenticavel {
  autenticar(usuario: string, senha: string): boolean
  renovarToken(): string
}

class ServicoAutenticacao {
  credenciais: Credencial[]
  sessoesAtivas: Sessao[]
  login(usuario: string, senha: string): Sessao
  logout(token: string): void
  validarToken(token: string): boolean
  alterarSenha(usuario: string, senhaAntiga: string, senhaNova: string): boolean
  .. <<acréscimo>> ..
  criarUsuario(usuario: string, senha: string, papel: PapelUsuario): Credencial
}

class Credencial {
  usuario: string
  hashSenha: string
  salt: string
  ultimoAcesso: Date
  papel: PapelUsuario
  verificarSenha(senhaPlana: string): boolean
  atualizarUltimoAcesso(): void
}

class Sessao {
  token: string
  usuario: string
  papel: PapelUsuario
  criacao: Date
  expiracao: Date
  isValida(): boolean
  renovar(): void
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

class ServicoRelatorio {
  gerarRelatorioPorOrganizacao(organizacaoId: string, periodo: {inicio: Date, fim: Date}): string
  gerarRelatorioPorStatus(status: StatusRastreamento): string
  gerarRelatorioFinanceiro(periodo: {inicio: Date, fim: Date}): string
}

class ServicoLote {
  repositorio: RepositorioArquivo
  criarLote(dados: any): Lote
  adicionarEquipamentoLote(loteId: string, equipamento: Equipamento): void
  processarTriagem(loteId: string): void
  consultarLotePorPeriodo(dataInicio: Date, dataFim: Date): Lote[]
}

class ServicoEquipamento {
  repositorio: RepositorioArquivo
  rastrearEquipamento(id: string): HistoricoCompleto
  atualizarEstadoFisico(id: string, novoEstado: EstadoFisico): void
  gerarCodigoBarras(tipo: TipoEquipamento, sequencia: number): string
  .. <<acréscimo>> ..
  atualizarEstadoFisicoJustificado(id: string, novoEstado: EstadoFisico, justificativa: string): void
  atualizarStatus(id: string, novoStatus: StatusRastreamento, justificativa: string): void
  registrarMovimentacao(id: string, destino: string): void
}

class ServicoOrganizacao {
  repositorio: RepositorioArquivo
  validadorCNPJ: ValidadorCNPJ
  cadastrarOrganizacao(dados: any): Organizacao
  buscarOrganizacao(id: string): Organizacao
  listarOrganizacoesAtivas(): Organizacao[]
  renovarContrato(organizacaoId: string, novoVencimento: Date): void
}

class RepositorioArquivo {
  diretorioBase: string
  criptografia: CriptografiaArquivo
  salvarEntidade(nomeArquivo: string, entidade: any): void
  carregarEntidade(nomeArquivo: string, id: string): any
  listarEntidades(nomeArquivo: string): any[]
  excluirEntidade(nomeArquivo: string, id: string): void
}

class CriptografiaArquivo {
  cifrar(dados: string, chave: string): string
  decifrar(dadosCifrados: string, chave: string): string
  gerarChave(): string
}

abstract class Validador <<abstract>> {
  validar(objeto: any): boolean
  obterMensagemErro(): string
}

class ValidadorDataEntrada {
  validar(data: Date): boolean
}

class ValidadorCNPJ {
  validar(cnpj: string): boolean
}

class Organizacao {
  id: string
  razaoSocial: string
  cnpj: string
  inscricaoEstadual: string
  enderecoCompleto: string
  telefone: string
  email: string
  dataCadastro: Date
  ativo: boolean
  contratoVigente: Contrato
  alterarEndereco(novoEndereco: string): void
  desativar(): void
}

class Contrato {
  id: string
  organizacaoId: string
  dataAssinatura: Date
  dataVencimento: Date
  clausulas: string[]
  valorMensal: number
  renovacaoAutomatica: boolean
  estaVigente(): boolean
  renovar(novoVencimento: Date): void
}

class Lote {
  id: string
  dataEntrada: Date
  organizacaoId: string
  notaFiscal: string
  transportadora: string
  equipamentos: Equipamento[]
  statusProcessamento: StatusLote
  observacoes: string
  adicionarEquipamento(equip: Equipamento): void
  removerEquipamento(equipId: string): boolean
  calcularPesoTotal(): number
  gerarRelatorioTriagem(): string
}

class Equipamento {
  id: string
  codigoBarrasInterno: string
  tipo: TipoEquipamento
  marca: string
  modelo: string
  anoFabricacao: number
  estadoFisico: EstadoFisico
  pesoQuilogramas: number
  loteId: string
  posicaoNoLote: number
  statusRastreamento: StatusRastreamento
  historicoMovimentacao: Movimentacao[]
  atualizarStatus(novoStatus: StatusRastreamento, justificativa: string): void
  registrarMovimentacao(destino: string, responsavel: string): void
  calcularDepreciacao(): number
}

class Movimentacao {
  id: string
  equipamentoId: string
  dataHora: Date
  origem: string
  destino: string
  responsavel: string
  observacao: string
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

' ---------------- acréscimos exigidos pelo texto do enunciado
class ServicoParametros <<acréscimo>> {
  obter(): ParametrosGlobais
  consultar(): ParametrosGlobais
  definir(grupo: string, chave: string, valor: number): ParametrosGlobais
}
class ParametrosGlobais <<acréscimo>>
class ServicoAuditoria <<acréscimo>> {
  listar(filtro): RegistroJournal[]
  verificar(): ResultadoVerificacao
  reverter(transacao: string): boolean
}
class FabricaOrganizacao <<acréscimo>>
class FabricaLote <<acréscimo>>
class FabricaEquipamento <<acréscimo>>
class GerenciadorJournal <<acréscimo>>

' ---------------- relacionamentos do UML do enunciado
CLIInterface "1" --> "1" ServicoAutenticacao : delega >
CLIInterface "1" --> "1" ServicoOrganizacao : delega >
CLIInterface "1" --> "1" ServicoLote : delega >
CLIInterface "1" --> "1" ServicoEquipamento : delega >
CLIInterface "1" --> "1" ServicoRelatorio : delega >
CLIInterface "1" --> "0..1" Sessao : mantém >

JournalTransacao "0..*" --> "1" ServicoAutenticacao : registrado por >
JournalTransacao "0..*" --> "1" ServicoLote : registrado por >
JournalTransacao "0..*" --> "1" ServicoEquipamento : registrado por >
JournalTransacao "0..*" --> "1" ServicoOrganizacao : registrado por >

Credencial ..|> Autenticavel
Sessao ..|> Autenticavel
ServicoAutenticacao "1" --> "0..*" Credencial : gerencia >
ServicoAutenticacao "1" --> "0..*" Sessao : gerencia >
Credencial "1" --> "0..*" Sessao : gera >
Sessao "1" --> "1" Credencial : autenticada por >
Credencial "1" --> "0..*" PapelUsuario : possui >

ServicoRelatorio "1" --> "1" ServicoLote : consulta >
ServicoRelatorio "1" --> "1" ServicoEquipamento : consulta >
ServicoLote "1" --> "1" RepositorioArquivo : utiliza >
ServicoEquipamento "1" --> "1" RepositorioArquivo : utiliza >
ServicoOrganizacao "1" --> "1" RepositorioArquivo : utiliza >
ServicoOrganizacao "1" --> "1" ValidadorCNPJ : utiliza >
RepositorioArquivo "1" --> "1" CriptografiaArquivo : utiliza >

ValidadorDataEntrada --|> Validador
ValidadorCNPJ --|> Validador

Organizacao "1" -- "0..1" Contrato : possui >
Contrato "1" --> "1" Organizacao : pertence a >
Organizacao "1" -- "0..*" Lote : gera >
Lote "1" --> "1" Organizacao : pertence a >
Lote "1" --> "1" StatusLote : classificado como >
Lote "1" -- "1..*" Equipamento : contém >
Equipamento "1" --> "1" Lote : pertence a >
Equipamento "1" --> "1" TipoEquipamento : classificado como >
Equipamento "1" --> "1" EstadoFisico : apresenta >
Equipamento "1" --> "1" StatusRastreamento : possui >
Equipamento "1" -- "0..*" Movimentacao : registra >
Movimentacao "1" --> "1" Equipamento : referencia >

' ---------------- relacionamentos dos acréscimos
ServicoRelatorio ..> ServicoParametros : alíquotas
ServicoAuditoria --> GerenciadorJournal
GerenciadorJournal --> JournalTransacao : grava/confirma
ServicoOrganizacao ..> FabricaOrganizacao : cria via
ServicoLote ..> FabricaLote : cria via
FabricaEquipamento ..> ServicoEquipamento : gerarCodigoBarras
Equipamento ..> ParametrosGlobais : depreciação
@enduml
