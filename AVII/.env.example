# Copie para .env e ajuste. O .env não vai para o git.
DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode?schema=public"
# Banco usado apenas pelos testes automatizados (é apagado e recriado a cada execução).
DATABASE_URL_TESTE="postgresql://greencode:greencode@localhost:5432/greencode_teste?schema=public"

PORT=3000
HOST=0.0.0.0
# Segredo de assinatura dos tokens JWT: no mínimo 32 caracteres aleatórios.
JWT_SEGREDO="troque-este-segredo-por-um-valor-aleatorio-longo"
# Minutos de inatividade até o token expirar.
SESSAO_MINUTOS=30
# Nível de log do Fastify: fatal, error, warn, info, debug, trace ou silent.
LOG_NIVEL=info
